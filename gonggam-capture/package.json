{
  "name": "gonggam-capture",
  "version": "1.0.0",
  "description": "공감캡처 — 수업 화면을 찍고, 보고서까지 한 번에",
  "author": "공감에듀테크",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "kr.gonggamedutech.capture",
    "productName": "공감캡처",
    "artifactName": "공감캡처-setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "공감캡처",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
